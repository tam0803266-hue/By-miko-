local CORRECT_KEY = "miko"
local IsScriptVerified = false
local GodModeActive = false

-- Hàm xử lý God Mode (Bất tử mượt, không can thiệp thô bạo vào bộ nhớ để bypass anti-cheat)
local function ToggleGodMode()
	if not IsScriptVerified then return end
	if debounce then return end
	debounce = true
	
	GodModeActive = not GodModeActive
	
	if GodModeActive then
		GodStatusText.Text = "Trạng thái God Mode: ĐANG BẬT ✔️"
		GodStatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
		
		-- Vòng lặp bất tử tối ưu, tự động khóa máu liên tục ở Client một cách an toàn
		task.spawn(function()
			while GodModeActive do
				local character = player.Character
				if character then
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health > 0 then
						-- Liên tục đưa máu về trạng thái tối đa dựa trên luồng xử lý mượt (không gây sốc đổi giá trị)
						humanoid.Health = humanoid.MaxHealth
					end
				end
				task.wait(0.01) -- Chạy cực nhanh để không thể bị chết đột ngột bởi quái hoặc người chơi khác
			end
		end)
	else
		GodStatusText.Text = "Trạng thái God Mode: ĐANG TẮT ❌"
		GodStatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
	
	task.wait(0.5) -- Giới hạn 0.5 giây mới cho bấm Bật/Tắt lại, tránh lag và bypass hệ thống check spam của Roblox
	debounce = false
end

-- Hiệu ứng lướt chuột qua nút
CheckButton.MouseEnter:Connect(function()
	TweenService:Create(CheckButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(230, 60, 60)}):Play()
end)

CheckButton.MouseLeave:Connect(function()
	TweenService:Create(CheckButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(190, 45, 45)}):Play()
end)

-- Click kiểm tra Key
CheckButton.MouseButton1Click:Connect(function()
	if KeyBox.Text == CORRECT_KEY then
		IsScriptVerified = true
		local fadeTween = TweenService:Create(MainFrame, TweenInfo.new(0.5), {Size = UDim2.new(0,0,0,0), BackgroundTransparency = 1})
		fadeTween:Play()
		
		fadeTween.Completed:Connect(function()
			MainFrame.Visible = false
			SkillFrame.Visible = true
			
			-- Kích hoạt kết nối Remote an toàn lên Server
			local HuTaoRemote = ReplicatedStorage:WaitForChild("HuTaoSystem", 3):WaitForChild("HuTaoRemote", 3)
			if HuTaoRemote then
				HuTaoRemote:FireServer("miko", "InitSuccess")
			end
		end)
	else
		KeyBox.Text = ""
		KeyBox.PlaceholderText = "SAI KEY RỒI! VUI LÒNG THỬ LẠI..."
		KeyBox.PlaceholderColor3 = Color3.fromRGB(255, 100, 100)
	end
end)

-- Nhận diện phím bấm hệ thống
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not IsScriptVerified then return end
	
	-- Bấm G để bật tắt chế độ Bất Tử (God Mode)
	if input.KeyCode == Enum.KeyCode.G then
		ToggleGodMode()
	end
end)

-- [ANTI-TAMPER]: Tự động xóa UI và dừng hoạt động nếu phát hiện có kẻ gian cố tình xóa/đổi tên Script để lấy cắp
task.spawn(function()
	while true do
		task.wait(2)
		if ScreenGui and ScreenGui.Parent ~= pGui then
			GodModeActive = false
			IsScriptVerified = false
			break
		end
	end
end)
